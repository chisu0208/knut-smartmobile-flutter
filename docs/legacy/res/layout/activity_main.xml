<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_margin="1dp">
    <include layout="@layout/content_main"/>
    <RelativeLayout
        android:gravity="right"
        android:orientation="vertical"
        android:id="@+id/popup_bg_container"
        android:background="#66000000"
        android:focusable="true"
        android:visibility="gone"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/popup_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <RelativeLayout
                android:id="@+id/popup_header"
                android:background="@drawable/round_popup_header"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="58dp">
                <LinearLayout
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:id="@+id/sub_head_container"
                    android:background="@drawable/round_head"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_centerInParent="true"/>
                <LinearLayout
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:id="@+id/sub_head2_container"
                    android:background="@drawable/round_head_title"
                    android:layout_width="250dp"
                    android:layout_height="44dp"
                    android:layout_centerInParent="true"/>
                <LinearLayout
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:id="@+id/sub_center_container"
                    android:background="@drawable/round_head_title"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_centerInParent="true"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"/>
                <LinearLayout
                    android:orientation="horizontal"
                    android:id="@+id/sub_left_container"
                    android:padding="3dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:layout_marginBottom="5dp"
                    android:layout_alignParentLeft="true"
                    android:layout_centerVertical="true"
                    android:layout_marginEnd="5dp"/>
                <LinearLayout
                    android:orientation="horizontal"
                    android:id="@+id/sub_right_container"
                    android:padding="3dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:layout_marginBottom="5dp"
                    android:layout_alignParentRight="true"
                    android:layout_centerVertical="true"
                    android:layout_marginEnd="5dp"/>
            </RelativeLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/popup_body"
                android:background="@drawable/round_popup_body"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="10">
                <FrameLayout
                    android:id="@+id/webview_frame"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <kr.ac.ut.util.RoundedWebView
                        android:id="@+id/popup_webview"
                        android:background="#66000000"
                        android:visibility="visible"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"/>
                </FrameLayout>
            </LinearLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/popup_footer"
                android:background="@drawable/round_popup_footer"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="50dp"/>
        </LinearLayout>
    </RelativeLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
