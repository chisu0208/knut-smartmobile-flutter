<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 원본 AppTheme(Theme.AppCompat.Light.DarkActionBar)의 색. 시스템 대화상자(AlertDialog)가
         원본과 같은 모양·버튼 색(colorAccent)으로 보이도록 AppCompat 테마를 쓴다.
         원본에 야간 테마가 없으므로 values-night도 두지 않는다. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="colorPrimary">#006bd0</item>
        <item name="colorPrimaryDark">#3700b3</item>
        <item name="colorAccent">#03dac5</item>
    </style>

    <!-- 프로세스가 시작되어 Flutter 첫 화면이 그려질 때까지 -->
    <style name="LaunchTheme" parent="AppTheme">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>

    <!-- Flutter 화면 뒤의 창 -->
    <style name="NormalTheme" parent="AppTheme">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>
